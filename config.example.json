{
  "ai_mode": "doubao_web",
  "headless": false,
  "max_tweets": 3,
  "reply_max_length": 100,
  "like_tweets": true,
  "interaction_delay_seconds": 15,
  "api": {
    "provider": "openai",
    "protocol": "",
    "base_url": "",
    "model": "",
    "timeout_seconds": 120,
    "max_output_tokens": 1024,
    "trust_env": true,
    "extra_body": {}
  },
  "doubao": {
    "timeout_seconds": 120,
    "selectors": {
      "input": "textarea, [contenteditable=\"true\"][role=\"textbox\"]",
      "assistant": "[data-testid=\"receive_message\"] [data-testid=\"message_text_content\"]",
      "stop": "[data-testid=\"chat_input_local_break_button\"]"
    },
    "backend": "playwright",
    "browser_channel": "chrome"
  }
}
