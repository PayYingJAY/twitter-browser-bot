{
  "ai_mode": "doubao_web",
  "headless": false,
  "max_tweets": 3,
  "reply_max_length": 100,
  "like_tweets": true,
  "interaction_delay_seconds": 15,
  "continuous": false,
  "interaction_delay_seconds_range": [60, 150],
  "reading_delay_seconds": [4, 10],
  "scroll_delay_seconds": [3, 7],
  "idle_delay_seconds": [90, 180],
  "history_sync_scrolls": 15,
  "follow_back": {
    "enabled": false,
    "interval_seconds": [30,60],
    "cooldown_seconds": [300,600,1800,3600,43200]
  },
  "twitter_browser": {
    "mode": "isolated"
  },
  "api": {
    "provider": "openai",
    "protocol": "",
    "base_url": "",
    "model": "",
    "timeout_seconds": 120,
    "max_output_tokens": 1024,
    "trust_env": true,
    "extra_body": {}
  },
  "doubao": {
    "timeout_seconds": 120,
    "selectors": {
      "input": "textarea, [contenteditable=\"true\"][role=\"textbox\"]",
      "assistant": "[data-testid=\"receive_message\"] [data-testid=\"message_text_content\"]",
      "stop": "[data-testid=\"chat_input_local_break_button\"]"
    },
    "backend": "playwright",
    "browser_channel": "chrome"
  }
}
